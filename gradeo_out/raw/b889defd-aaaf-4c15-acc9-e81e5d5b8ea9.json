9eba-dddcf978e9a7","type":"TEXT","displayIndex":3,"distractor":null,"text":"<p>Enjoy outdoor activities freely</p>","equation":null,"tableRow":null,"image":null}],"optionsSettings":null,"settings":null,"correctOptions":["f0b68b26-7247-4547-a511-73e378a7ab91"]},"files":null},"markingCriteriaContentItem":null,"markingRubricContentItem":null,"markingGuidanceContentItem":null,"sampleAnswerContentItem":null}]},{"id":"6caaa737-a26c-4d51-9fef-5e824e28cff0","title":"Types of Machine Learning Algorithms (SA, TKS 2025)","isPublished":true,"publishDate":"2025-09-01T22:46:09.524Z","syllabusId":"d1a54432-597e-4e3c-a5c6-ad7a134726e4","stimulusContentItemCollection":null,"publisher":null,"dynamicFields":null,"copyrightText":"TKS 2025","visibility":"PRIVATE","school":{"id":"7572b03a-1507-4309-950e-2a286bdcf0a4","name":"The King's School, Parramatta"},"systemId":null,"system":null,"isPublisherLocked":false,"parts":[{"id":"eff8a65b-41e6-482f-874e-795f25260d9e","displayIndex":0,"title":"Part 1","metadata":{"id":"096f3828-aab2-406f-9f8f-b8c1928c45b4","mark":3,"syllabus":{"id":"d1a54432-597e-4e3c-a5c6-ad7a134726e4","title":"Software Engineering","description":"Software Engineering Stage 6 Syllabus 2022","gradeFrom":12,"gradeTo":12,"coverageLabel":null,"curriculumCode":null,"curriculumVersion":null,"gradingScaleName":null,"publishedYear":null,"publishedDate":null},"band":null,"outcomeIds":["858fde69-da06-440b-8093-01c934aebcfa","dcef6a21-eee4-49d1-aa3d-429cdf127cdc","62083f53-20d4-4148-9a06-ef580b3b6dd0"],"topicIds":["d75b51a8-dc28-4cb8-9a78-a0c2ceb18b0f"],"subtopicIds":["7f16da58-013d-4ed1-809e-e0fe02349458"],"subtopicItemIds":["8137833b-1522-4052-9e6b-527d5066b089"],"bandIds":["266e22f1-3f8a-4fbd-95bd-e7a6221d1c65","b87d71ee-5ae9-43f7-a1f5-feec3f1db295","d48b51b8-7f70-4d46-91cf-95b7bf902f0c"]},"content":{"id":"b5e9c1c8-e84f-4076-835d-6021b9b4b64a","contentItemCollection":{"id":"2c8080e3-29e5-4e86-980b-b01f83fb4e5f","items":[{"id":"644daee3-afa1-4b28-b3da-01e6084172e4","updatedDate":"2025-08-01T01:44:27.069Z","files":null,"type":"RICH_TEXT","text":"<p>Describe the role of logistic regression in enhancing the performance of spam detection systems.</p>"}],"itemIdOrder":["644daee3-afa1-4b28-b3da-01e6084172e4"]},"contentItemMetadata":null},"answer":{"id":"f1061e29-e8c5-4598-91f9-380e84df07ee","parameters":{"version":0,"type":"SHORT","extendedView":true,"settings":{"version":0,"wordLimit":true,"wordCount":100,"exactValue":false,"richText":true,"imageUpload":false,"equationEditor":false,"calculatorInterface":false},"correctValues":null},"files":null},"markingCriteriaContentItem":{"id":"4b3a5383-a22d-487a-9e70-bb54a110cbf4","updatedDate":"2025-08-01T01:44:50.047Z","files":null,"type":"MARKING_CRITERIA","criteria":[{"criterion":"<p>Clearly describes the role of logistic regression in enhancing the performance of spam detection systems.</p>","point":"<p>3</p>"},{"criterion":"<p>Outlines how logistic regression can enhance the performance of spam detection systems.&nbsp;</p>","point":"<p>2</p>"},{"criterion":"<p>Provides some relevant information.</p>","point":"<p>1</p>"}]},"markingRubricContentItem":null,"markingGuidanceContentItem":null,"sampleAnswerContentItem":{"id":"7dae6c89-2246-4ee6-97ec-b810cc1ce37f","updatedDate":"2026-10-20T09:25:05.094Z","files":null,"type":"RICH_TEXT","text":"<p>In spam detection systems, logistic regression serves as a robust algorithm to classify emails based on textual content, metadata, and historical interaction data. Logistic regression takes features such as frequency of certain spam-indicative words, the presence of links, sender information, and other patterns to output a probability score indicating the likelihood of an email being spam. By training the model on a labelled dataset of emails, the logistic regression model learns the boundaries between 'spam' and 'not spam', helping filter incoming emails accurately. Over time, its adaptive nature ensures that the system stays resilient against evolving spam tactics, maintaining high detection performance and enhancing user experience by reducing false positives and negatives.</p>"}}]}],"answers":[{"partId":"62c8717f-d0f9-4091-8f3d-fd90e3101902","studentId":"0071efd7-8807-43a2-96e7-9085b48c8632","examAnswerSheetItem":null,"mark":null,"markingSessionMarkingItemList":[]},{"partId":"332bff30-9e41-434e-9704-f14bf7d9b63e","studentId":"0071efd7-8807-43a2-96e7-9085b48c8632","examAnswerSheetItem":null,"mark":null,"markingSessionMarkingItemList":[]},{"partId":"ad038928-e33b-4fed-8fc3-6361e616e8b2","studentId":"0071efd7-8807-43a2-96e7-9085b48c8632","examAnswerSheetItem":null,"mark":null,"markingSessionMarkingItemList":[]},{"partId":"d3407b1f-4fc3-42f0-9077-a609233ee3c8","studentId":"0071efd7-8807-43a2-96e7-9085b48c8632","examAnswerSheetItem":null,"mark":null,"markingSessionMarkingItemList":[]},{"partId":"eff8a65b-41e6-482f-874e-795f25260d9e","studentId":"0071efd7-8807-43a2-96e7-9085b48c8632","examAnswerSheetItem":null,"mark":null,"markingSessionMarkingItemList":[]}],"state":{"isFinished":true,"dynamicFieldSeed":null,"markerUserList":[{"id":"4e096daa-d1c7-47e9-9c7b-c1adaf476532","firstName":"TKS","lastName":"CST"}],"examTitle":"12SEN_Cycle11"}}