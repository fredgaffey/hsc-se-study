c3","fd537dce-3aca-46d4-a4ec-123c6ee1a4aa","cf4a9f47-9917-4b58-b2dd-7bcb59e8282e"]},"files":null},"markingCriteriaContentItem":{"id":"6f5df2d3-f71d-40b3-9ef8-681c2f10cb10","updatedDate":"2025-07-02T03:25:51.186Z","files":null,"type":"MARKING_CRITERIA","criteria":[{"criterion":"<p>Correctly selects all options</p>","point":"<p>2</p>"},{"criterion":"<p>Partially correct selection</p>","point":"<p>1</p>"}]},"markingRubricContentItem":null,"markingGuidanceContentItem":null,"sampleAnswerContentItem":null}]},{"id":"99317d23-d872-443c-b764-b6c3f2bebfee","title":"Collaboration Benefits (SA, TKS 2025)","isPublished":true,"publishDate":"2025-07-21T05:12:34.501Z","syllabusId":"d1a54432-597e-4e3c-a5c6-ad7a134726e4","stimulusContentItemCollection":null,"publisher":null,"dynamicFields":null,"copyrightText":"TKS 2025","visibility":"PRIVATE","school":{"id":"7572b03a-1507-4309-950e-2a286bdcf0a4","name":"The King's School, Parramatta"},"systemId":null,"system":null,"isPublisherLocked":false,"parts":[{"id":"129b6f70-2854-4453-a529-de4300a840c8","displayIndex":0,"title":"Part A","metadata":{"id":"3db773df-3925-476c-bb5a-de3c0738f939","mark":4,"syllabus":{"id":"d1a54432-597e-4e3c-a5c6-ad7a134726e4","title":"Software Engineering","description":"Software Engineering Stage 6 Syllabus 2022","gradeFrom":12,"gradeTo":12,"coverageLabel":null,"curriculumCode":null,"curriculumVersion":null,"gradingScaleName":null,"publishedYear":null,"publishedDate":null},"band":null,"outcomeIds":["dcef6a21-eee4-49d1-aa3d-429cdf127cdc","880073ce-5d0d-42bf-8c8c-3fc3d64646df","858fde69-da06-440b-8093-01c934aebcfa","10d250f1-b45a-44c3-96b5-942f2657212e"],"topicIds":["a45d4626-6ce7-44bc-b6a2-d0fcaeea9412"],"subtopicIds":["f688e948-0754-41f7-8f81-79e0c3a0e473"],"subtopicItemIds":["aed1fb0d-105c-463b-8a9b-abd62f8ad436"],"bandIds":["266e22f1-3f8a-4fbd-95bd-e7a6221d1c65","b87d71ee-5ae9-43f7-a1f5-feec3f1db295"]},"content":{"id":"5e6b275b-28eb-4b4a-b90b-96c50e96199a","contentItemCollection":{"id":"540df844-19c5-4690-84b3-3e4f637be9b9","items":[{"id":"77c11482-cc0d-4d22-b8b6-0100b17f3c0c","updatedDate":"2025-07-08T03:20:29.469Z","files":null,"type":"RICH_TEXT","text":"<p>Describe how collaborative code reviews contribute to the security of a software system. In your answer, refer to specific benefits of having multiple team members involved in reviewing code.</p>"}],"itemIdOrder":["77c11482-cc0d-4d22-b8b6-0100b17f3c0c"]},"contentItemMetadata":null},"answer":{"id":"8f223c03-7671-4527-95ae-6f97eee46f4a","parameters":{"version":0,"type":"SHORT","extendedView":true,"settings":{"version":0,"wordLimit":false,"wordCount":null,"exactValue":false,"richText":true,"imageUpload":false,"equationEditor":false,"calculatorInterface":false},"correctValues":null},"files":null},"markingCriteriaContentItem":{"id":"5a5b1613-238c-4e21-a881-b1f5fbcc858e","updatedDate":"2025-07-08T03:20:53.494Z","files":null,"type":"MARKING_CRITERIA","criteria":[{"criterion":"<p>Demonstrates a thorough understanding of how collaborative code reviews improve security, with specific and relevant benefits clearly explained</p>","point":"<p>4</p>"},{"criterion":"<p>Shows a sound understanding of code review benefits with some relevant explanation.</p>","point":"<p>3</p>"},{"criterion":"<p>Identifies a general benefit of code reviews with limited or vague explanation.</p>","point":"<p>2</p>"},{"criterion":"<p>Provides a basic or general statement about teamwork or checking code, without clear links to security.</p>","point":"<p>1</p>"}]},"markingRubricContentItem":null,"markingGuidanceContentItem":null,"sampleAnswerContentItem":{"id":"60f50464-7b73-40a4-9201-bdb2b40e8fba","updatedDate":"2025-07-08T03:20:40.021Z","files":null,"type":"RICH_TEXT","text":"<p>Collaboration is important in secure software development because no single developer can identify every possible vulnerability or threat. Security is a complex area that benefits from multiple perspectives and areas of expertise. While one developer may be skilled in coding secure authentication, another may be better at identifying potential network vulnerabilities. By working together, the team can address more risks and validate each other&rsquo;s work, which increases the overall quality and resilience of the software. Relying on one person increases the chance of blind spots or overlooked errors, while collaboration spreads responsibility and strengthens the final product.</p>"}}]},{"id":"0edf9b36-5998-439e-b74c-364dea60e842","title":"Social/Ethical/Legal Issues (SA, TKS 2025)","isPublished":true,"publishDate":"2025-07-21T04:53:51.333Z","syllabusId":"d1a54432-597e-4e3c-a5c6-ad7a134726e4","stimulusContentItemCollection":null,"publisher":null,"dynamicFields":null,"copyrightText":null,"visibility":"PRIVATE","school":{"id":"7572b03a-1507-4309-950e-2a286bdcf0a4","name":"The King's School, Parramatta"},"systemId":null,"system":null,"isPublisherLocked":false,"parts":[{"id":"e60c0d3a-45e8-4c0d-91b0-e81cbaff8a33","displayIndex":0,"title":"Part A","metadata":{"id":"d64fc5b3-b7fe-4fd5-881f-4adb3d5d15aa","mark":3,"syllabus":{"id":"d1a54432-597e-4e3c-a5c6-ad7a134726e4","title":"Software Engineering","description":"Software Engineering Stage 6 Syllabus 2022","gradeFrom":12,"gradeTo":12,"coverageLabel":null,"curriculumCode":null,"curriculumVersion":null,"gradingScaleName":null,"publishedYear":null,"publishedDate":null},"band":null,"outcomeIds":["880073ce-5d0d-42bf-8c8c-3fc3d64646df","dcef6a21-eee4-49d1-aa3d-429cdf127cdc","d37b0608-71dc-40b5-9bdd-791cd53903ee"],"topicIds":["a45d4626-6ce7-44bc-b6a2-d0fcaeea9412"],"subtopicIds":["f688e948-0754-41f7-8f81-79e0c3a0e473"],"subtopicItemIds":["218361aa-1cb5-4b5b-b3c3-ecbb658a7962"],"bandIds":["266e22f1-3f8a-4fbd-95bd-e7a6221d1c65","b87d71ee-5ae9-43f7-a1f5-feec3f1db295"]},"content":{"id":"0829f49b-a19f-4af0-8445-2f2dc89cceb7","contentItemCollection":{"id":"22fe3413-0e2d-4693-af90-718974717c9f","items":[{"id":"40c78c8b-a85f-4bb7-a9bc-862824e99151","updatedDate":"2025-07-09T00:54:20.192Z","files":null,"type":"RICH_TEXT","text":"<p>&nbsp;Discuss the ethical considerations enterprises must address regarding privacy when developing secure software.</p>"}],"itemIdOrder":["40c78c8b-a85f-4bb7-a9bc-862824e99151"]},"contentItemMetadata":null},"answer":{"id":"46c27f1e-47d1-4221-b7e7-fc5347f0fcc0","parameters":{"version":0,"type":"SHORT","extendedView":true,"settings":{"version":0,"wordLimit":false,"wordCount":null,"exactValue":false,"richText":true,"imageUpload":false,"equationEditor":false,"calculatorInterface":false},"correctValues":null},"files":null},"markingCriteriaContentItem":{"id":"dbd4f981-8157-477f-96a3-ab6ec6cbc04c","updatedDate":"2025-07-09T00:54:43.422Z","files":null,"type":"MARKING_CRITERIA","criteria":[{"criterion":"<p>Clearly discusses ethical privacy considerations with relevant details.</p>","point":"<p>3</p>"},{"criterion":"<p>Provides a general explanation of privacy ethics with limited specifics.</p>","point":"<p>2</p>"},{"criterion":"<p>Makes vague or incomplete statements about privacy ethics.</p>","point":"<p>1</p>"}]},"markingRubricContentItem":null,"markingGuidanceContentItem":null,"sampleAnswerContentItem":{"id":"62f8b34b-c351-411f-9fd6-bd3e0f0853d6","updatedDate":"2025-07-09T00:54:48.989Z","files":null,"type":"RICH_TEXT","text":"<p>Enterprises must ensure that secure software respects individuals' privacy rights by protecting personal data from unauthorized access and misuse. Ethically, users should have control over how their data is collected and used, including options to consent or opt-out. Developers should implement features like encryption and data anonymization to safeguard privacy. Ignoring these ethical responsibilities can lead to loss of trust and harm to users. For example, an online platform that allows users to manage their privacy settings demonstrates respect for user autonomy and complies with ethical standards.</p>"}}]}],"answers":[{"partId":"3ff7834a-9187-4d8e-8f53-540a3ad4c746","studentId":"0071efd7-8807-43a2-96e7-9085b48c8632","examAnswerSheetItem":null,"mark":null,"markingSessionMarkingItemList":[]},{"partId":"129b6f70-2854-4453-a529-de4300a840c8","studentId":"0071efd7-8807-43a2-96e7-9085b48c8632","examAnswerSheetItem":null,"mark":null,"markingSessionMarkingItemList":[]},{"partId":"e60c0d3a-45e8-4c0d-91b0-e81cbaff8a33","studentId":"0071efd7-8807-43a2-96e7-9085b48c8632","examAnswerSheetItem":null,"mark":null,"markingSessionMarkingItemList":[]}],"state":{"isFinished":true,"dynamicFieldSeed":null,"markerUserList":[{"id":"4e096daa-d1c7-47e9-9c7b-c1adaf476532","firstName":"TKS","lastName":"CST"}],"examTitle":"12SEN_Cycle4"}}