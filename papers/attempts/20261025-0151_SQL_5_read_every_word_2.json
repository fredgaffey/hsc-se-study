  "1e1a7294-0fd4-4b00-a57b-c78f77d80f3c": {
   "text": "-- Y11\n-- != paid \n-- F: Name | amount \n-- Order by high to low \n\nSELECT Students.Name, Payments.Amount\nFROM Students, Payments\nWHERE Students.StudentID = Payments.StudentID AND \n   Students.Year = 11 AND \n   Payments.Paid = 'No'\nORDER BY Payments.Amount DESC\n   "
  },
  "a5209c91-34d2-45ce-bb02-bd7edbf60dda": {
   "text": "-- F: genre | Number of views AS Views | AVE AS AvgMinutes\n-- t > 30 min \n-- LOW to HIGH AVE\n\nSELECT Genre, COUNT (Genre) AS Views,\n  SUM (MinutesWatched)/COUNT (MinutesWatched) AS AvgMinutes\nFROM Views\nWHERE MinutesWatched >= 30\nGROUP BY Genre\nORDER BY AvgMinutes DESC"
  },
  "da904423-8ab9-4a5b-96c0-01fe8b58cf45": {
   "text": "Select Players.Name AS Player, COUNT(GoalID) AS Goals\nFROM Players, Goals\nWHERE Players.PlayerID = Goals.PlayerID AND \n   Players.Team = 'Hawks'\nGROUP BY Goals.PlayerID\nORDER BY Goals DESC"
  },
