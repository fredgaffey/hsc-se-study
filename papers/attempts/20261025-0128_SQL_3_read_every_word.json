  "971e2526-d7a0-4f70-86d9-990962ed34f9": {
   "text": "SELECT Menu.ItemName AS Drink,\n   sum(Orders.Qty) AS NumberSold\nFROM Menu, Orders\nWHERE Menu.ItemID = Orders.ItemID AND\n   Menu.Category = 'Drink'\nGROUP BY Menu.ItemName\nORDER BY Drink DESC"
  }
