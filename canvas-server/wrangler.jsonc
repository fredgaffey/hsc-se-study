{
  "name": "canvas",
  "main": "src/index.js",
  "compatibility_date": "2026-06-24",

  // ../canvas (the course site in this repo) is the site root. html_handling "none" serves /pages/x.html directly
  // instead of 307-redirecting to /pages/x — that redirect broke navigations
  // that passed through the service worker.
  "assets": {
    "directory": "../canvas",
    "binding": "ASSETS",
    // the Worker must see every request, otherwise static files bypass the login gate
    "run_worker_first": true,
    "html_handling": "none"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sen-offline",
      "database_id": "2ed5b521-790f-47e8-99b0-07a3806f68cf"
    }
  ],

  "observability": { "enabled": true }
}
