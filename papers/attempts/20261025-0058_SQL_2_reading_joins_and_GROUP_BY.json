 "answers": {
  "eed0dc4e-4a62-4438-b94b-b5f25cef1ed2": {
   "text": "First you are useing the table \"posts\" this table has coumbs like published and category_id.\nyou remove all the posts that are not pubised.\nNext you grouping it by category_id this will allow you to count the number in each catogory"
  },
  "93a8a071-9ff8-4b83-aa3a-15eae63fefde": {
   "text": "SELECT Level, COUNT(*)\nFROM *\nGROUP BY Level"
  },
  "de371dd3-b6fa-4d1d-8aa0-5a288ead2ae9": {
   "text": "SELECT Players.Name, Scores.Points\nFROM Scores, Players\nWHERE Players.PlayerID = Scores.PlayerID AND \n   Players.Country = \"AU\" AND\n   Scores.Points > 1000\n\n"
  },
  "4a3de07c-85f7-48c0-a76c-6950f45da0b9": {
   "text": "SELECT Category,\n   COUNT (Transaction_ID ) AS Number_of_Transactions,\n   SUM (Quantity) as Total_Items_Sold,\n   SUM (Quantity*1.0)/COUNT (Quantity*1.0) AS Average_Items_Per_Transaction,\n   SUM(Unit_Price* Quantity) AS Total_Revenue,\n   MAX (Unit_Price) AS Highest_Unit_Price\n\nFROM Sales_Transactions\nWHERE Quantity > 1\nGROUP BY Category\nORDER BY Total_Revenue DESC"
  }
 },
