TIVE_RESPONSE","settings":{"allowMultipleCorrectCellsInRow":false,"allowPartialMark":false},"header":[{"id":"844e35a2-a238-4e87-87df-c72d73e3a740","text":""},{"id":"c5fdba95-1450-4e70-9227-fd7a26179595","text":"<p>HTML</p>"},{"id":"7eb4ddc3-083b-4978-8567-8a0a28ad8a04","text":"<p>CSS</p>"},{"id":"ddba9276-65d8-4b41-b004-4823dd02a883","text":"<p>JavaScript</p>"}],"rows":[{"id":"ca2df304-caa2-41aa-8dcd-628d6b1f74b6","cells":[{"id":"cf96f0b5-6480-43f1-bae8-94749368e647","text":"<p>Defines styles and layout</p>"},{"id":"4df6217e-867d-4afe-b22c-725f442e23c3","text":null},{"id":"b71a24c8-ebe8-4f9a-bd24-0ec24eb8f4be","text":null},{"id":"8ad5b4e7-df64-42f0-8c8a-042cc0d565d6","text":null}]},{"id":"e979e0fd-8a62-4f01-9cb4-d9c2ad67b6b1","cells":[{"id":"68fb1526-cc24-48d7-8241-f0f4d379992a","text":"<p>Defines structure and content</p>"},{"id":"265b4547-d591-454d-bbd9-71488191373c","text":null},{"id":"e97b423a-f061-446d-851e-6c0f5db860d9","text":null},{"id":"6439acd3-21e7-43d0-9e19-d1159c1d70d4","text":null}]},{"id":"12495e59-edf0-450e-afa8-6101366167a5","cells":[{"id":"354c9208-dad8-452b-b126-47a50ea0aa5d","text":"<p>Adds interactivity and dynamic content</p>"},{"id":"e817500e-00fc-48f3-a4bb-14bf379859d7","text":null},{"id":"0fb6bb43-8d08-4266-8886-f58458718f49","text":null},{"id":"946710b0-4dc3-45cb-9851-8d4f73a731a3","text":null}]}],"correctCellIds":["b71a24c8-ebe8-4f9a-bd24-0ec24eb8f4be","265b4547-d591-454d-bbd9-71488191373c","946710b0-4dc3-45cb-9851-8d4f73a731a3"]},"files":null},"markingCriteriaContentItem":null,"markingRubricContentItem":null,"markingGuidanceContentItem":null,"sampleAnswerContentItem":null}]},{"id":"4778057c-e86b-472a-8c5b-8908c9de703f","title":"Managing Load Times (SA, TKS2025)","isPublished":true,"publishDate":"2025-09-01T22:16:38.574Z","syllabusId":"d1a54432-597e-4e3c-a5c6-ad7a134726e4","stimulusContentItemCollection":{"id":"7b71c593-98a7-4de2-b88f-5ca3d1d9161c","items":[{"id":"18317417-34cf-42f4-a1bd-6831604a1df8","updatedDate":"2025-07-31T06:55:14.544Z","files":null,"type":"RICH_TEXT","text":"<p data-start=\"89\" data-end=\"210\">A team is developing a web application that is experiencing long load times. They observe that:</p>\n<ul data-start=\"212\" data-end=\"409\">\n<li data-start=\"212\" data-end=\"273\">\n<p data-start=\"214\" data-end=\"273\">The application uses many large image files</p>\n</li>\n<li data-start=\"274\" data-end=\"332\">\n<p data-start=\"276\" data-end=\"332\">It includes multiple external JavaScript and CSS files</p>\n</li>\n<li data-start=\"333\" data-end=\"409\">\n<p data-start=\"335\" data-end=\"409\">The server reprocesses the same database queries for every user request</p>\n</li>\n</ul>"}],"itemIdOrder":["18317417-34cf-42f4-a1bd-6831604a1df8"]},"publisher":null,"dynamicFields":null,"copyrightText":"TKS 2025","visibility":"PRIVATE","school":{"id":"7572b03a-1507-4309-950e-2a286bdcf0a4","name":"The King's School, Parramatta"},"systemId":null,"system":null,"isPublisherLocked":false,"parts":[{"id":"ab40c8cf-a99f-4fb5-9c1b-17ff3e554d2c","displayIndex":0,"title":"Part A","metadata":{"id":"c650f034-4400-4bf0-98ab-916e2a22eec2","mark":2,"syllabus":{"id":"d1a54432-597e-4e3c-a5c6-ad7a134726e4","title":"Software Engineering","description":"Software Engineering Stage 6 Syllabus 2022","gradeFrom":12,"gradeTo":12,"coverageLabel":null,"curriculumCode":null,"curriculumVersion":null,"gradingScaleName":null,"publishedYear":null,"publishedDate":null},"band":null,"outcomeIds":["62083f53-20d4-4148-9a06-ef580b3b6dd0","10d250f1-b45a-44c3-96b5-942f2657212e","880073ce-5d0d-42bf-8c8c-3fc3d64646df"],"topicIds":["dc9286c4-6091-4305-9bcf-522e1c1080e7"],"subtopicIds":["dd054126-4515-4373-b96f-75402f2452b7"],"subtopicItemIds":["a7ed48aa-2f48-412c-99e3-f480b7fcf931"],"bandIds":["266e22f1-3f8a-4fbd-95bd-e7a6221d1c65","d48b51b8-7f70-4d46-91cf-95b7bf902f0c"]},"content":{"id":"8a33f553-0d47-41ac-b307-e19451930ca9","contentItemCollection":{"id":"6d444dae-2fc5-4081-889c-e7878e854509","items":[{"id":"06c23cd0-766d-4379-88ea-80585b6da5f9","updatedDate":"2025-07-31T06:54:47.288Z","files":null,"type":"RICH_TEXT","text":"<p data-start=\"411\" data-end=\"518\">Outline TWO methods the team could implement to improve the load times of the web application.</p>"}],"itemIdOrder":["06c23cd0-766d-4379-88ea-80585b6da5f9"]},"contentItemMetadata":null},"answer":{"id":"1f9cfc70-94fd-4bfa-89e4-d2c5d4a0b07e","parameters":{"version":0,"type":"SHORT","extendedView":true,"settings":{"version":0,"wordLimit":true,"wordCount":40,"exactValue":false,"richText":false,"imageUpload":false,"equationEditor":false,"calculatorInterface":false},"correctValues":null},"files":null},"markingCriteriaContentItem":{"id":"471f3c97-4230-483d-9d49-6dac5542a158","updatedDate":"2025-07-31T06:54:59.532Z","files":null,"type":"MARKING_CRITERIA","criteria":[{"criterion":"<p>Correctly outlines two methods the team could implement to improve the load times of the web application.</p>","point":"<p>2</p>"},{"criterion":"<p>Correctly outlines one methods the team could implement to improve the load times of the web application.</p>","point":"<p>1</p>"}]},"markingRubricContentItem":null,"markingGuidanceContentItem":null,"sampleAnswerContentItem":{"id":"73afc751-e6fe-471a-9a3e-1c9e5cce03a3","updatedDate":"2025-07-31T06:57:44.946Z","files":null,"type":"RICH_TEXT","text":"<p>Any two of the three:</p>\n<ul>\n<li data-start=\"119\" data-end=\"190\">\n<p data-start=\"121\" data-end=\"190\">Compress the image files to reduce their size and speed up loading.</p>\n</li>\n<li data-start=\"191\" data-end=\"274\">\n<p data-start=\"193\" data-end=\"274\">Combine JavaScript and CSS files to reduce the number of HTTP requests.</p>\n</li>\n<li data-start=\"191\" data-end=\"274\">Implement server-side caching to store and quickly serve frequently accessed content without reprocessing each request.</li>\n</ul>"}}]},{"id":"1cff7561-21a7-43f4-9325-8ee81bfa4b91","title":"Cascading Style Sheets (SA, TKS2025)","isPublished":true,"publishDate":"2025-07-31T02: