   "text": "SELECT Members.Name, Loans.BookTitle, Loans.LoanDate\nFROM Loans, Members\nWHERE Loans.MemberID = Members.MemberID AND\n   LoanDate >= '2025-01-01' AND LoanDate < '2026-01-10' AND\n   Loans.Returned = 'No'\nORDER BY Members.Name ASC"
  },
  "0653cd29-9de6-4a5b-8980-474fad813555": {
   "text": "MemberName |  Visits\nEve                       | 1\nDev                       | 1\nBen                       | 1\nAna                       | 2 "
  },
  "a2cb140c-0872-4d89-9a0d-61f81b3164c3": {
   "text": "SELECT Class,\n   COUNT (Status) AS Attended,\n   SUM (Minutes) AS TotalMinutes\nFROM Sessions\nWHERE Status = 'Attended'\nGROUP BY Class"
