f080","updatedDate":"2025-07-30T23:29:12.578Z","files":null,"type":"MARKING_CRITERIA","criteria":[{"criterion":"<p>Clearly describes how separating content from styling contributes to a consistent appearence across a website.</p>","point":"<p>2</p>"},{"criterion":"<p>Provides some relevant information.</p>","point":"<p>1</p>"}]},"markingRubricContentItem":null,"markingGuidanceContentItem":null,"sampleAnswerContentItem":{"id":"b80ec080-dd2a-4b20-8edd-fe50602a91cd","updatedDate":"2025-07-30T23:32:07.147Z","files":null,"type":"RICH_TEXT","text":"<p>With content (HTML) and styling (CSS) separated, designers can apply uniform styling rules from one place, ensuring every page follows the same layout, colours, and typography, producing a consistent appearance.</p>"}}]}],"answers":[{"partId":"7689c074-0c65-4b14-9a17-d52d7b25ea9c","studentId":"0071efd7-8807-43a2-96e7-9085b48c8632","examAnswerSheetItem":null,"mark":null,"markingSessionMarkingItemList":[]},{"partId":"ab40c8cf-a99f-4fb5-9c1b-17ff3e554d2c","studentId":"0071efd7-8807-43a2-96e7-9085b48c8632","examAnswerSheetItem":null,"mark":null,"markingSessionMarkingItemList":[]},{"partId":"9d91d4e9-f2e0-4133-a541-217b77839089","studentId":"0071efd7-8807-43a2-96e7-9085b48c8632","examAnswerSheetItem":null,"mark":null,"markingSessionMarkingItemList":[]}],"state":{"isFinished":true,"dynamicFieldSeed":null,"markerUserList":[{"id":"4e096daa-d1c7-47e9-9c7b-c1adaf476532","firstName":"TKS","lastName":"CST"}],"examTitle":"12SEN_Cycle8"}}